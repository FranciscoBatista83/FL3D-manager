# =============================================================================
# FL3D Manager - Exemplo de Variáveis de Ambiente (.env.example)
# =============================================================================
# Este arquivo é um MODELO para configuração do ambiente.
# Ele é seguro para commitar no GitHub pois NÃO contém valores reais.
#
# COMO USAR:
#   1. Copie este arquivo e renomeie para ".env"
#   2. Preencha os valores com as informações reais do seu ambiente
#   3. Nunca commite o ".env" — ele está no .gitignore
# =============================================================================

# Chave secreta do Django — gere uma nova com:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=substitua-por-uma-chave-secreta-gerada

# Modo de depuração: True para desenvolvimento, False para produção
DEBUG=True

# Hosts permitidos separados por vírgula
ALLOWED_HOSTS=127.0.0.1,localhost
